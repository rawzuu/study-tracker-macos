{
  "manifest_version": 3,
  "default_locale": "cs",
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "1.0",
  "icons": { "128": "icon.png" },
  "background": { "scripts": ["background.js"], "persistent": false },
  "permissions": ["declarativeNetRequestWithHostAccess", "nativeMessaging", "webNavigation", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
